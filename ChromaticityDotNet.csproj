<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.4.1</Version>
    <Authors>MartinHung</Authors>
    <PackageLicenseExpression>MIT AND CC-BY-SA-4.0</PackageLicenseExpression>
    <LangVersion>10.0</LangVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>app-icon.png</PackageIcon>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- Applications have their own build and publication pipeline. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);apps/**</DefaultItemExcludes>
    <RepositoryUrl>https://github.com/MatinxHT/ChromaticityDotNet</RepositoryUrl>
    <description>ChromaticityDotNet is a .Net Core SDK for chromaticity programming. You can find some useful standard illuminant data in 'ChromaticityDotNet.Model' and cover color space conversion and color difference calculations in 'ChromaticityDotNet.Controller.' You can also perform any other tasks you need.</description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="CIE-DATA-NOTICE.md" Pack="true" PackagePath="\" />
    <None Include="assets/branding/app-icon.png" Pack="true" PackagePath="\" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

</Project>
