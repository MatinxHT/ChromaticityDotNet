{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tools: build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/apps/Chromaticity.Tools.Browser/Chromaticity.Tools.Browser.csproj",
        "-p:GeneratePackageOnBuild=false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
