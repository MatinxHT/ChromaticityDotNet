<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chromaticity.Tools.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <FontFamily x:Key="ContentControlThemeFontFamily">avares://Chromaticity.Tools/Assets#Chromaticity UI</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#222222" RegionColor="#FFFFFF" ErrorText="#222222" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#222222" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#222222" />
      <Setter Property="BorderBrush" Value="#222222" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3D3D3D" />
      <Setter Property="BorderBrush" Value="#3D3D3D" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#111111" />
      <Setter Property="BorderBrush" Value="#111111" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
  </Application.Styles>
</Application>
